{
  "seconds": 56,
  "language": "zh-CN",
  "segments": [
    {
      "start": 0.45,
      "end": 4.089104166666667,
      "text": "从入户玄关开始，一起看看这个家的布局。"
    },
    {
      "start": 5.45,
      "end": 8.6879375,
      "text": "外面是独立洗手台，往里走是公共卫生间。"
    },
    {
      "start": 11.1,
      "end": 15.412104166666667,
      "text": "走进次卧，床铺靠墙布置，窗边引入自然光。"
    },
    {
      "start": 16.05,
      "end": 19.741583333333335,
      "text": "穿过推拉门来到阳台，另一侧安排了洗衣区。"
    },
    {
      "start": 20.8,
      "end": 26.07989583333333,
      "text": "回到客厅，沙发、茶几和电视墙，让起居空间更舒适。"
    },
    {
      "start": 29.15,
      "end": 32.4604375,
      "text": "接着是主卧，床头和柜体延续柔和的浅色调。"
    },
    {
      "start": 34.05,
      "end": 36.3084375,
      "text": "主卫用玻璃隔开淋浴区。"
    },
    {
      "start": 38.15,
      "end": 42.50629166666667,
      "text": "再看书房，书架沿墙展开，书桌靠近窗边。"
    },
    {
      "start": 44.0,
      "end": 48.23233333333334,
      "text": "最后来到餐厨区，餐桌与厨房相邻，动线紧凑。"
    },
    {
      "start": 49.6,
      "end": 53.376020833333335,
      "text": "看完厨房，再回望客厅，这就是完整的全屋导览。"
    }
  ]
}
